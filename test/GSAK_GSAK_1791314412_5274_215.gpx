<gsak:LonBeforeCorrect>23.732</gsak:LonBeforeCorrect>
</gsak:wptExtension><groundspeak:cache id="10138444" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
<groundspeak:name>Η αψίδα του Αδριανού - L Arc d Hadrien</groundspeak:name>
<groundspeak:placed_by>unknown</groundspeak:placed_by>
<groundspeak:owner id="26763564">unknown</groundspeak:owner>
<groundspeak:type>Earthcache</groundspeak:type>
<groundspeak:container>Other</groundspeak:container>
<groundspeak:difficulty>2</groundspeak:difficulty>
<groundspeak:terrain>1</groundspeak:terrain>
<groundspeak:short_description html="False"></groundspeak:short_description>
<groundspeak:long_description html="False"></groundspeak:long_description>
<groundspeak:encoded_hints></groundspeak:encoded_hints>
<groundspeak:logs>
<groundspeak:log id="-2">
<groundspeak:type>Write note</groundspeak:type>
<groundspeak:finder id="0">GSAK</groundspeak:finder>
<groundspeak:text>
Vloženo : 2026-08-05
Drive in : NE
Ověřeno: Na výchozích
Poznámky :
1) The arch is 18 meters high, 13 meters wide, and built of Pentelic marble.
2) It has two sections—the lower one represents a Roman triumphal arch, and the upper one a traditional Greek propylon.
3) Yes, you can see lighter, newly added marble blocks with sharper edges, contrasting with the darker, weathered original stone. Cast marble was used.
4) The inscriptions are carved into the architrave:  &amp;quot;This is Athens, the ancient city of Theseus.&amp;quot;,  &amp;quot;This is the city of Hadrian and not of Theseus.&amp;quot;
</groundspeak:text>
</groundspeak:log>
</groundspeak:logs>
</groundspeak:cache>
</wpt>

